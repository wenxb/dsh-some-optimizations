{
  "name": "dsh-some-optimizations",
  "version": "0.2.0",
  "description": "一些优化:个人 LLM 链路优化开关集 —— 合成 tool-call id 归一化、解除长思考流式空闲超时、模型钉死(最后点选的模型强制生效于所有请求),均可在设置中单独开关。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.spec.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "*",
    "@deepseek-ai/schemastery": "*",
    "undici": "^7.0.0"
  }
}
